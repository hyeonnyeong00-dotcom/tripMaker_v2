# Supabase Postgres 연결 문자열(JDBC). Settings > Database > Connection string(JDBC)에서 확인.
# 예: jdbc:postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
SUPABASE_DB_URL=
JWT_SECRET=
AI_API_KEY=

# --- 로컬에서 Supabase 없이 테스트하는 방법 (Homebrew postgresql@16 기준) ---
# 소켓 경로가 길면(103바이트 제한) 실패하므로 데이터 디렉터리와 소켓 디렉터리를 분리한다.
#
# 1) 임시 DB 클러스터 초기화 + 기동
#    initdb -D /tmp/pgdata -U postgres --auth=trust -E UTF8
#    mkdir -p /tmp/pgsock
#    pg_ctl -D /tmp/pgdata -o "-p 5433 -k /tmp/pgsock" -l /tmp/pgdata.log start
#
# 2) DB 생성 + pgcrypto 확장(gen_random_uuid() 사용, V1 마이그레이션 필수)
#    psql -h /tmp/pgsock -p 5433 -U postgres -d postgres -c "CREATE DATABASE tripmaker;"
#    psql -h /tmp/pgsock -p 5433 -U postgres -d tripmaker -c "CREATE EXTENSION IF NOT EXISTS pgcrypto;"
#
# 3) 위 SUPABASE_DB_URL 대신 아래 값으로 백엔드 기동 (Flyway가 V1/V2 마이그레이션 자동 적용)
#    export SUPABASE_DB_URL="jdbc:postgresql://localhost:5433/tripmaker?user=postgres"
#    export JWT_SECRET="local-dev-secret-key-for-testing-only-32bytes-min"
#    export AI_API_KEY="dummy"
#    ./gradlew bootRun
#
# 4) 종료 시 정리
#    pg_ctl -D /tmp/pgdata stop -m fast
#
# V2 시드 데이터의 admin 계정: admin@tripplanner.local / Admin1234!
