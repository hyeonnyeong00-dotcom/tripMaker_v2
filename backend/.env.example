# Supabase Postgres 연결 문자열(JDBC). Settings > Database > Connection string(JDBC)에서 확인.
# 예: jdbc:postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
SUPABASE_DB_URL=
JWT_SECRET=
# Anthropic API 키(https://console.anthropic.com). 저비용 모델(claude-haiku 계열) 사용.
AI_API_KEY=
# 선택: 미설정 시 claude-haiku-4-5-20251001 사용
AI_MODEL=

# --- 로컬에서 Supabase 없이 테스트하는 방법 (Homebrew postgresql@16 기준) ---
# 소켓 경로가 길면(103바이트 제한) 실패하므로 데이터 디렉터리와 소켓 디렉터리를 분리한다.
#
# 1) 임시 DB 클러스터 초기화 + 기동
#    initdb -D /tmp/pgdata -U postgres --auth=trust -E UTF8
#    mkdir -p /tmp/pgsock
#    pg_ctl -D /tmp/pgdata -o "-p 5433 -k /tmp/pgsock" -l /tmp/pgdata.log start
#
# 2) DB 생성 + pgcrypto 확장(gen_random_uuid() 사용, V1 마이그레이션 필수)
#    psql -h /tmp/pgsock -p 5433 -U postgres -d postgres -c "CREATE DATABASE tripmaker;"
#    psql -h /tmp/pgsock -p 5433 -U postgres -d tripmaker -c "CREATE EXTENSION IF NOT EXISTS pgcrypto;"
#
# 3) 위 SUPABASE_DB_URL 대신 아래 값으로 백엔드 기동 (Flyway가 V1/V2 마이그레이션 자동 적용)
#    export SUPABASE_DB_URL="jdbc:postgresql://localhost:5433/tripmaker?user=postgres"
#    export JWT_SECRET="local-dev-secret-key-for-testing-only-32bytes-min"
#    export AI_API_KEY="dummy"
#    ./gradlew bootRun
#
# 4) 종료 시 정리
#    pg_ctl -D /tmp/pgdata stop -m fast
#
# V2 시드 데이터의 admin 계정: admin@tripplanner.local / Admin1234!

# --- M4 (POST /api/trips) 실키 검증 재현 절차 ---
# 위 1~3단계로 로컬 DB+백엔드를 띄우되, 3단계에서 AI_API_KEY를 실제 Anthropic 키로 바꿔서 기동한다.
#    export AI_API_KEY="sk-ant-..."
#
# 1) 회원가입 + 로그인해서 access_token 발급
#    curl -s localhost:8080/api/auth/signup -H "Content-Type: application/json" \
#      -d '{"email":"tester@example.com","password":"Password123!"}'
#    TOKEN=$(curl -s localhost:8080/api/auth/login -H "Content-Type: application/json" \
#      -d '{"email":"tester@example.com","password":"Password123!"}' | python3 -c \
#      'import sys,json;print(json.load(sys.stdin)["access_token"])')
#
# 2) 최초 생성 요청(캐시 미스 → 실제 AI 호출 기대, 로그에서 "AI 응답 캐시 미스" 확인)
#    curl -s -X POST localhost:8080/api/trips -H "Content-Type: application/json" \
#      -H "Authorization: Bearer $TOKEN" -d '{"destination":"부산","start_date":"2026-08-01",
#      "end_date":"2026-08-03","budget_min":100000,"budget_max":300000,"companion":"couple",
#      "preferences":["힐링","먹방"],"include_nearby":false,
#      "active_start_time":"09:00","active_end_time":"21:00"}'
#
# 3) 동일 조건 재요청(캐시 히트 기대, 로그에서 "AI 응답 캐시 히트, AI 미호출" 확인 + 응답속도 확연히 빨라짐)
#    (2번과 완전히 동일한 curl 재실행)
#
# 4) include_nearby / budget_min·budget_max / companion / active_start_time·active_end_time 중
#    하나라도 바꿔 재요청 → 캐시 키가 달라져 다시 "캐시 미스"로 떨어지는지 확인
#    (2번 curl에서 값 하나를 바꿔 재실행, 예: "companion":"solo")
#
# 5) active_start_time/active_end_time을 생략하고 재요청 → 기본값(09:00/21:00)으로 채워져
#    4번의 09:00/21:00 요청과 동일한 캐시 키로 히트되는지 확인
#
# 참고: bootRun 로그에서 ItineraryGenerationService의 cacheKey 로그 라인으로 캐시 히트/미스를 직접 확인 가능.
